# Copy to .env and fill in for local testing against real Supabase/Postgres.
# Leave .env absent (or these unset) to use local SQLite + disk instead -
# no cloud credentials needed for plain local development.

# Settings -> Database -> Connection string (use the "Transaction" pooler
# connection string, not the direct one - Fly machines connect/disconnect
# on scale-to-zero, which the pooler handles better)
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Settings -> API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Storage -> bucket name (must exist - see README for how to create it)
SUPABASE_STORAGE_BUCKET=thermal-images

# Only matters once actually served over HTTPS - leave unset/false for local dev
SESSION_HTTPS_ONLY=false

# Optional: pin the session-cookie signing key instead of the auto-generated
# local one. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=

# Optional: enables the "Export to Google Docs" report option (Workspace
# only - service accounts can't write to a personal My Drive). Leave both
# unset to leave that feature disabled (the button 501s).
#
# Google Cloud Console -> IAM & Admin -> Service Accounts -> (your account)
# -> Keys -> Add key -> JSON. Paste the full file contents here (or, for
# local dev, put a path to the downloaded .json file instead).
GOOGLE_SERVICE_ACCOUNT_JSON=

# The ID from a Shared Drive folder's URL (the part after .../folders/) -
# a *Shared* Drive, not a personal My Drive folder. Add the service
# account's email (from the JSON key's "client_email" field) to that Shared
# Drive as a Content Manager (or above) so it's allowed to create files there.
GOOGLE_DRIVE_FOLDER_ID=
